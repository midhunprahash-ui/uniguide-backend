# ===================
# UniGuide Backend Configuration
# ===================

# Gemini AI (required)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
TAVILY_API_KEY=your_tavily_api_key
EVENT_DISCOVERY_GEMINI_BUDGET=3

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# File Upload (optional - has defaults)
# UPLOAD_DIRECTORY=./uploads
# MAX_FILE_SIZE_MB=50
# UPLOAD_ASYNC_THRESHOLD_MB=10

# Upload Queue (optional)
# REDIS_URL=redis://localhost:6379/0
# UPLOAD_JOB_TIMEOUT_SEC=1800
# UPLOAD_JOB_RESULT_TTL_SEC=3600
# UPLOAD_JOB_FAILURE_TTL_SEC=3600
